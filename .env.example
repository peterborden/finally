# FinAlly environment configuration
# Copy this file to .env and fill in values as needed:
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# Required for real AI chat responses. Get a key at https://openrouter.ai/keys
# Leave blank (or set LLM_MOCK=true below) to run without an AI chat backend.
OPENROUTER_API_KEY=

# Optional. Massive (Polygon.io) API key for real market data.
# Leave blank to use the built-in GBM market simulator (recommended default).
MASSIVE_API_KEY=

# Optional. Set to "true" for deterministic mock LLM responses
# (used in tests / CI, or to try the app without an OPENROUTER_API_KEY).
LLM_MOCK=false
